{
  "name": "bmms-central",
  "productName": "BMMS Central",
  "version": "0.1.5",
  "description": "Hub de aplicaciones de producción BMMS con actualizaciones por archivos.",
  "author": "BMMS",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg zip",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.bmms.central",
    "productName": "BMMS Central",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "hub/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../central/channel",
        "to": "channel",
        "filter": [
          "stable.json",
          "stable.json.sig"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mendezmat/BMMS-PROJECT/releases/download/central-latest",
        "channel": "latest"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BMMS-Central-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BMMS Central"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "BMMS-Central-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "BMMS TB Tool usa el micrófono para detectar el talkback."
      }
    },
    "protocols": [
      {
        "name": "BMMS Central",
        "schemes": [
          "bmms-central"
        ]
      }
    ]
  }
}
